{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingzhou.local/benchmark/task.schema.json",
  "title": "QingzhouEvalTask",
  "type": "object",
  "required": [
    "id",
    "source",
    "core_task",
    "prompt",
    "locale",
    "requires_login",
    "success_criteria",
    "judge",
    "timeout_s",
    "license_note",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id, e.g. om2w:<task_id> or self:form-login-001"
    },
    "source": {
      "type": "string",
      "enum": [
        "open:online-mind2web",
        "open:webvoyager",
        "self"
      ],
      "description": "v0.3 open-source controls keep source=open:* with ids om2w-v03:/wv-v03: and derived_from"
    },
    "source_task_id": {
      "type": "string"
    },
    "core_task": {
      "type": "string",
      "enum": [
        "research",
        "compare",
        "skill_reuse",
        "batch_collect",
        "form_fill"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "start_url": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "requires_login": {
      "type": "boolean"
    },
    "success_criteria": {
      "type": "object",
      "description": "rule keys: must_include[], any_of[[...]], must_not_include[], must_match[regex], numbers_near[{key,value,rel_tol|abs_tol}], items[]/min_fraction, min_rows, review (human spot-check note), type=skill_two_stage with create/reuse"
    },
    "judge": {
      "type": "string",
      "enum": [
        "rule",
        "llm_judge",
        "human"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 30
    },
    "license_note": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "pending_website",
        "draft"
      ]
    },
    "website_status": {
      "type": "string"
    },
    "gold": {},
    "pair": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "description": "Two-stage tasks (skill_reuse): run sequentially, each in a new session",
      "items": {
        "type": "object",
        "required": [
          "name",
          "prompt"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "start_url": {
            "type": "string"
          },
          "new_session": {
            "type": "boolean"
          }
        }
      }
    },
    "skill_name": {
      "type": "string",
      "description": "Skill name template; {run} replaced by runner run tag"
    },
    "temporal": {
      "type": "boolean",
      "description": "Live/volatile answer; judge against page at run time"
    },
    "budget": {
      "type": "object",
      "description": "Soft efficiency budget (v0.3). Recorded by judge.py as over_budget; never changes the verdict.",
      "properties": {
        "max_tool_calls": {
          "type": "integer"
        },
        "max_elapsed_s": {
          "type": "integer"
        },
        "max_screenshots": {
          "type": "integer"
        }
      }
    },
    "hardness": {
      "type": "string",
      "description": "Why this task is hard (v0.3)"
    },
    "drift_policy": {
      "type": "string",
      "description": "How the gold may drift over time and how judging tolerates it"
    },
    "gold_source": {
      "type": "string"
    },
    "gold_verified_at": {
      "type": "string"
    },
    "keep_reason": {
      "type": "string",
      "description": "Open-source controls: why this task was retained"
    },
    "derived_from": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
